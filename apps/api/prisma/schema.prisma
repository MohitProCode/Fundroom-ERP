// Prisma Schema for Fundroom ERP
// PostgreSQL - Production-grade mini ERP system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTHENTICATION
// =============================================================================

enum UserRole {
  ADMIN
  SALES_USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Argon2id hashed password
  name      String
  role      UserRole @default(SALES_USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================================================
// MASTER DATA
// =============================================================================

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  phone        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  gstNumber    String?
  contactPerson String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  enquiries    Enquiry[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]

  @@index([name])
  @@map("customers")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  description   String?
  category      String?
  unit          String   @default("PCS") // PCS, KG, MTR, LTR, etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  inventory     Inventory?
  enquiryItems  EnquiryItem[]
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems DispatchItem[]

  @@index([sku])
  @@index([name])
  @@map("products")
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  reservedQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  // damagedQuantity Decimal @default(0) @db.Decimal(12, 3) // Future: Scenario A
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Constraints enforced at application level:
  // - physicalQuantity >= 0
  // - reservedQuantity >= 0
  // - reservedQuantity <= physicalQuantity
  // - available = physicalQuantity - reservedQuantity

  @@map("inventory")
}

// =============================================================================
// ENQUIRY WORKFLOW
// =============================================================================

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

model Enquiry {
  id            String        @id @default(uuid())
  enquiryNumber String        @unique // ENQ-YYYY-NNNNNN
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        EnquiryStatus @default(NEW)
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  items         EnquiryItem[]
  quotations    Quotation[]

  @@index([enquiryNumber])
  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id          String   @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([enquiryId])
  @@index([productId])
  @@map("enquiry_items")
}

// =============================================================================
// QUOTATION WORKFLOW
// =============================================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique // QUO-YYYY-NNNNNN
  enquiryId       String?
  enquiry         Enquiry?        @relation(fields: [enquiryId], references: [id])
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  terms           String?
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  items           QuotationItem[]
  salesOrder      SalesOrder?

  // Calculated totals (backend-authoritative)
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  totalDiscount   Decimal         @default(0) @db.Decimal(14, 2)
  totalGst        Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal         @default(0) @db.Decimal(14, 2)

  @@index([quotationNumber])
  @@index([customerId])
  @@index([enquiryId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantity       Decimal   @db.Decimal(12, 3)
  unitPrice      Decimal   @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  gstPercent     Decimal   @default(18) @db.Decimal(5, 2)

  // Calculated fields (backend-authoritative)
  baseAmount     Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(14, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(14, 2)
  gstAmount      Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal   @default(0) @db.Decimal(14, 2)

  notes          String?
  createdAt      DateTime  @default(now())

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// =============================================================================
// SALES ORDER WORKFLOW
// =============================================================================

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique // SO-YYYY-NNNNNN
  quotationId     String           @unique // Prevents duplicate conversion
  quotation       Quotation        @relation(fields: [quotationId], references: [id])
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          SalesOrderStatus @default(PENDING)
  orderDate       DateTime         @default(now())
  expectedDelivery DateTime?
  notes           String?
  createdBy       String
  confirmedBy     String?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  items           SalesOrderItem[]
  dispatches      Dispatch[]

  // Totals (copied from quotation for record-keeping)
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  totalDiscount   Decimal          @default(0) @db.Decimal(14, 2)
  totalGst        Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal          @default(0) @db.Decimal(14, 2)

  @@index([orderNumber])
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String      @id @default(uuid())
  salesOrderId    String
  salesOrder      SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Decimal     @db.Decimal(12, 3)
  reservedQuantity Decimal    @default(0) @db.Decimal(12, 3)
  dispatchedQuantity Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice       Decimal     @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  gstPercent      Decimal     @default(18) @db.Decimal(5, 2)

  // Calculated fields
  baseAmount      Decimal     @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(14, 2)
  taxableAmount   Decimal     @default(0) @db.Decimal(14, 2)
  gstAmount       Decimal     @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal     @default(0) @db.Decimal(14, 2)

  createdAt       DateTime    @default(now())

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

// =============================================================================
// DISPATCH WORKFLOW
// =============================================================================

model Dispatch {
  id              String   @id @default(uuid())
  dispatchNumber  String   @unique // DSP-YYYY-NNNNNN
  salesOrderId    String
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  dispatchDate    DateTime @default(now())
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  items           DispatchItem[]

  @@index([dispatchNumber])
  @@index([salesOrderId])
  @@map("dispatches")
}

model DispatchItem {
  id              String      @id @default(uuid())
  dispatchId      String
  dispatch        Dispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Decimal     @db.Decimal(12, 3)
  createdAt       DateTime    @default(now())

  @@index([dispatchId])
  @@index([productId])
  @@map("dispatch_items")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

enum AuditAction {
  // Authentication
  LOGIN
  LOGOUT
  TOKEN_REFRESH

  // Enquiry
  ENQUIRY_CREATED
  ENQUIRY_UPDATED
  ENQUIRY_STATUS_CHANGED

  // Quotation
  QUOTATION_CREATED
  QUOTATION_UPDATED
  QUOTATION_STATUS_CHANGED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED

  // Sales Order
  SALES_ORDER_CREATED
  SALES_ORDER_CONFIRMED
  SALES_ORDER_CANCELLED

  // Inventory
  INVENTORY_RESERVED
  INVENTORY_RELEASED
  INVENTORY_ADJUSTED

  // Dispatch
  DISPATCH_CREATED
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id])
  action      AuditAction
  entityType  String      // Customer, Enquiry, Quotation, SalesOrder, etc.
  entityId    String
  metadata    Json?       // Additional context
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
